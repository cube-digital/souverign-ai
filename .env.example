# Copy to .env (gitignored). Values stay on this machine.
LLM_PROFILE=            # fast | quality; empty = llm.active_profile in config/models.yaml
SA_MODELS_DIR=          # empty = ~/.cache/sovereign-agents/models
SA_PG_PORT=5433         # 5433 because a Homebrew Postgres already uses 5432
POSTGRES_PASSWORD=sa_dev_only
HERMES_SMOKE_API_KEY=   # empty = generated into .run/hermes-smoke.key
DATABASE_URL=           # empty = postgres://sa:sa_dev_only@127.0.0.1:5433/sa ; pglite://<dir> = in-process DB
RELAY_ADMIN_TOKEN=      # empty = make dev generates .run/relay-admin.token
SA_DEMO_PINS=           # e.g. ana:482913,vlad:...; empty = make seed generates PINs into .run/demo-pins.txt
BRIDGE_MASTER_KEY=      # empty = make dev/demo generate .run/bridge-master.key (encrypts agent keys)
OPS_SIM_URL=             # empty = http://127.0.0.1:8649 (simulated ops backend)
AGENT_RUNTIME=          # hermes (default) | echo (tests: answers with what is in its context)
HERMES_BIN=             # empty = hermes on PATH
PUBLIC_BASE_URL=        # e.g. https://<mac>.<tailnet>.ts.net or http://localhost:5173 ; sign-in redirects return here
GOOGLE_CLIENT_ID=       # empty = Google sign-in off (docs/auth.md)
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=    # comma list; Google sign-in stays off unless this or AUTH_ALLOWED_DOMAINS is set
AUTH_ALLOWED_DOMAINS=   # comma list of Google Workspace domains (must match the account's hd claim)
SA_DEMO_EMAILS=         # e.g. ana:you@example.com ; make seed links that demo user to this sign-in email
LIVEKIT_API_SECRET=     # empty = make dev/demo generate .run/livekit.secret (call server and token signing)
MEETING_TOKEN=          # empty = generated into .run/meeting.token (guards the bridge's /internal/calls/*)
SA_NOTETAKER=           # worker (default) | fake (spawns nothing, for tests) | off
SA_CALL_E2EE=           # 0 (default) | 1 = media end-to-end encryption in calls
SA_NOTES_INTERVAL_MS=   # empty = 300000 (interim call notes every 5 minutes)
SA_CALL_GRACE_MS=       # empty = 30000 (a call ends this long after the last person leaves)
AUDIO_URL=              # empty = http://127.0.0.1:8645 (audio-api: speech to text, text to speech)
